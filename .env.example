# Copy to .env and fill in your Alpaca credentials.
# Paper trading keys: https://app.alpaca.markets/paper/dashboard/overview

ALPACA_API_KEY=your_key_here
ALPACA_API_SECRET=your_secret_here

# Paper:  https://paper-api.alpaca.markets/v2
# Live:    https://api.alpaca.markets/v2
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2

# --- copy_trading_bot (politician mirror) -----------------------------------
# Capitol Trades politician slug. Default: Tim Moore (R-NC), highest-volume
# active trader. Find others at https://www.capitoltrades.com/politicians
COPY_POLITICIAN_ID=M001236
COPY_POLITICIAN_NAME=Tim Moore
# Dollars to deploy per mirrored buy. Sells close the held position fully.
COPY_TRADE_USD=500
COPY_MAX_TRADE_USD=2000
# Ignore disclosures whose trade date is older than this many days.
COPY_SKIP_OLDER_THAN_DAYS=90
# Set to "true" to log decisions without placing orders.
COPY_DRY_RUN=false
# Opt-in: drop a -15/-25/-35/-50% GTC limit-buy ladder under every mirror-buy.
COPY_ENABLE_LADDER=false
COPY_LADDER_MAX_USD=30000

# --- position_manager (trailing stops + optional re-entry) ------------------
# Trail percent for the SELL stop placed on every open position.
PSMGR_TRAIL_PCT=10
# Re-entry GTC limit BUY placed this % below current price when a stop is
# attached. 0 disables re-entry (default).
PSMGR_REENTRY_PCT=0
PSMGR_REENTRY_USD=500
PSMGR_DRY_RUN=false

# --- wheel_bot (cash-secured-put / covered-call wheel) ----------------------
# Comma-separated underliers to wheel. Default mix: PLTR (high-IV liquid),
# NANC (politician ETF; monthly options only -- bot will skip if no expiry
# in the DTE window), HOOD (mid-cap, weeklies available).
WHEEL_TICKERS=PLTR,NANC,HOOD
# Put strikes are sold this percent below current spot; calls this percent
# above. Tune for delta you want -- 10% on liquid names is roughly 0.20-0.30
# delta.
WHEEL_PUT_STRIKE_OFFSET_PCT=10
WHEEL_CALL_STRIKE_OFFSET_PCT=10
# Days-to-expiration window. 21 DTE target keeps theta decay near the
# steep part of the curve while leaving room to roll if the trade moves
# against us.
WHEEL_TARGET_DTE=21
WHEEL_DTE_MIN=14
WHEEL_DTE_MAX=28
# Buy-to-close when the contract is N% decayed (e.g. 50 = closed at half
# the original premium).
WHEEL_CLOSE_PROFIT_PCT=50
# But never inside this many days of expiration -- pin-risk near 0DTE
# beats the marginal premium remaining.
WHEEL_CLOSE_MIN_DTE=2
WHEEL_CONTRACTS_PER_CYCLE=1
# Skip any contract whose bid * 100 is below this many dollars (avoids
# selling pennies for commission).
WHEEL_MIN_PREMIUM_USD=10
# Set to "true" to decide + log without placing orders.
WHEEL_DRY_RUN=false
